# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to Git - it's in .gitignore for a reason

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ============================================================================
# PROFILE CONFIGURATION
# The application represents ONE predefined person.
# Ordinary users cannot change these - only the administrator can.
# ============================================================================

# Display name shown in chatbot (e.g., "John Doe")
PROFILE_DISPLAY_NAME=Kuruvilla Biju Cheruvallil

# GitHub username (public profile will be fetched)
# Example: "torvalds", "octocat"
PROFILE_GITHUB_USERNAME=KURUVILLABC

# LinkedIn profile ID or username (if LinkedIn API access available)
# Example: "bill-gates", "bill-gates-12345"
# Leave empty if LinkedIn access unavailable (will use mock provider)
PROFILE_LINKEDIN_ID=kuruvilla-biju-cheruvallil

# ============================================================================
# GITHUB CONFIGURATION
# GitHub public data is free to fetch
# Optional: Add token for higher rate limits (60/hour → 5000/hour)
# ============================================================================

# GitHub personal access token (optional)
# Get from: https://github.com/settings/tokens
# Permissions needed: repo (optional, for public data access)
GITHUB_TOKEN=

# ============================================================================
# LINKEDIN CONFIGURATION
# Only needed if your LinkedIn API access is available
# This typically requires official OAuth 2.0 setup
# ============================================================================

# LinkedIn OAuth 2.0 Configuration
# Only required if you have official LinkedIn API access
# Leave empty to use MockLinkedInProvider

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# ============================================================================
# AI PROVIDER CONFIGURATION
# Choose between OpenAI, Anthropic, or Mock
# ============================================================================

# AI Provider: "openai", "anthropic", or "mock"
# Set to "mock" for development without API keys
AI_PROVIDER=mock

# OpenAI Configuration
# Get API key from: https://platform.openai.com/api-keys
# Models: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Anthropic Configuration (alternative to OpenAI)
# Get API key from: https://console.anthropic.com
# Models: claude-3-opus, claude-3-sonnet, claude-3-haiku
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet

# ============================================================================
# KNOWLEDGE BASE CONFIGURATION
# ============================================================================

# Path to additional knowledge file (manual overrides)
# This file contains manually curated information about the profile
ADDITIONAL_KNOWLEDGE_PATH=knowledge/additional/additional-knowledge.json

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: "error", "warn", "info", "debug", "trace"
LOG_LEVEL=info

# Log file path (optional)
LOG_FILE=./logs/app.log

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================

# Cache TTL in seconds
# How long to keep cached data before re-fetching
CACHE_TTL_GITHUB=86400      # 24 hours
CACHE_TTL_LINKEDIN=86400    # 24 hours
CACHE_TTL_AI=3600           # 1 hour

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Rate limit: requests per minute per IP
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Comma-separated list of allowed origins
# For production: specify your exact domain(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# DATABASE CONFIGURATION (for future use)
# Currently using file-based storage and IndexedDB
# Uncomment when adding PostgreSQL support
# ============================================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/profile_ai
# DATABASE_MAX_CONNECTIONS=20
# DATABASE_IDLE_TIMEOUT=30000

# ============================================================================
# DEVELOPMENT OPTIONS
# ============================================================================

# Enable mock providers for development (disables real API calls)
USE_MOCK_PROVIDERS=false

# Enable verbose logging
DEBUG=false

# Skip knowledge base validation (not recommended)
SKIP_KB_VALIDATION=false

# ============================================================================
# SECURITY OPTIONS
# ============================================================================

# Enable prompt injection detection
ENABLE_PROMPT_INJECTION_DETECTION=true

# Enable hallucination detection
ENABLE_HALLUCINATION_DETECTION=true

# Secret key for request signing (if needed)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# ============================================================================
# DEPLOYMENT OPTIONS
# ============================================================================

# Set to true in production
IS_PRODUCTION=false

# Health check endpoint enabled
HEALTH_CHECK_ENABLED=true

# Metrics endpoint enabled
METRICS_ENABLED=false

# ============================================================================
# NOTES
# ============================================================================

# DO NOT:
# - Commit this file to Git (if it contains real secrets)
# - Share your API keys publicly
# - Use development keys in production
# - Store passwords in plain text

# DO:
# - Use a secret manager in production (AWS Secrets Manager, Vault, etc.)
# - Rotate API keys regularly
# - Use different keys for development, staging, production
# - Enable HTTPS in production
# - Monitor API usage and set up alerts

# ============================================================================
# DEVELOPMENT QUICK START
# ============================================================================

# For development with mock providers (no keys needed):
# NODE_ENV=development
# AI_PROVIDER=mock
# USE_MOCK_PROVIDERS=true

# For development with real APIs:
# NODE_ENV=development
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# GITHUB_TOKEN=ghp_...
# PROFILE_GITHUB_USERNAME=your-github
# PROFILE_DISPLAY_NAME=Your Name
