    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "groq-sdk": "^1.6.0",
    "openai": "^7.10.0",
    "profile-ai-knowledge-system": "file:..",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.54.0",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.54.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.0"
